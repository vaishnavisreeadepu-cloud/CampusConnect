rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isStudent() {
      return hasRole('student');
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles collection
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for student rosters, teacher profiles, messaging)
      allow read: if isAuthenticated();
      
      // Admins can create user profiles, or newly authenticated users can create their own profile
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
      
      // Admins can update any field. Users can update only non-protected personal fields on their own profile
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'studentId', 'employeeId', 'active', 'departmentId', 'classId'])
      );
    }

    // College Settings
    match /collegeSettings/{settingId} {
      allow read: if true; // Public can see college name, logo, contact
      allow write: if isAdmin();
    }

    // Departments, Programs, Academic Years, Classes, Subjects
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /academicYears/{yearId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /teacherAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Timetable Entries
    match /timetableEntries/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      // Anyone can read public/all announcements; authenticated users can read audience-targeted ones
      allow read: if resource.data.audience == 'all' || isAuthenticated();
      // Admins can manage all announcements; teachers can create class-level announcements
      allow create: if isAdmin() || (
        isTeacher() && request.resource.data.audience in getUserData().assignedClasses
      );
      allow update, delete: if isAdmin() || (
        isTeacher() && resource.data.authorId == request.auth.uid
      );
    }

    // Study Materials & Notes
    match /materials/{materialId} {
      // Students can read if enrolled in class; teachers and admins can read all
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && getUserData().classId == resource.data.classId)
      );
      // Only teachers assigned to the class or admins can upload
      allow create: if isAdmin() || (
        isTeacher() && request.resource.data.teacherId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isTeacher() && resource.data.teacherId == request.auth.uid
      );
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && getUserData().classId == resource.data.classId)
      );
      allow create: if isAdmin() || (
        isTeacher() && request.resource.data.teacherId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isTeacher() && resource.data.teacherId == request.auth.uid
      );
    }

    // Assignment Submissions
    match /submissions/{submissionId} {
      // Student who owns submission, assigned teachers, or admin can read
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        (isTeacher() && request.auth.uid in get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.teacherId)
      );
      // Student can create their own submission
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      // Student can update their own submission before it is graded; Teacher can update marks and feedback
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid && resource.data.status != 'graded') ||
        isTeacher()
      );
      allow delete: if isAdmin();
    }

    // Attendance Sessions and Records
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    match /attendanceRecords/{recordId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid)
      );
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    // Private Messaging / Conversations
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.teacherId ||
        request.auth.uid == resource.data.studentId ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.teacherId ||
        request.auth.uid == request.resource.data.studentId
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.teacherId ||
        request.auth.uid == resource.data.studentId
      );
      allow delete: if isAdmin();

      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.teacherId ||
          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.studentId ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.auth.uid == request.resource.data.senderId &&
          (request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.teacherId ||
           request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.studentId)
        );
        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.recipientId // To mark as read
        );
      }
    }

    // In-App Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated(); // Triggered on events
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Admissions Enquiries (Public can create, Admin can manage)
    match /admissionEnquiries/{enquiryId} {
      allow create: if true; // Public prospect inquiry form
      allow read, update, delete: if isAdmin();
    }

    // Audit logs (Read and write strictly restricted to admin/system)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
